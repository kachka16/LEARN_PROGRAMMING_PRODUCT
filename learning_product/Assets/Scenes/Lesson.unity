  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizeManage
  QnA:
  - Questions: "\u0425\u0442\u043E \u0441\u0442\u0432\u043E\u0440\u0438\u0432 \u043C\u043E\u0432\u0443
      \u0421++?"
    Answers:
    - "\u0420\u043E\u0431\u0456\u0442\u043D\u0456\u043A \u0420\u0443\u0442"
    - "\u0410\u043B\u044C\u0431\u0435\u0440\u0442 \u0415\u043D\u0448\u0442\u0435\u0439\u043D"
    - "\u0411'\u044F\u0440\u043D \u0421\u0442\u0440\u0430\u0443\u0441\u0442\u0440\u0443\u043F"
    CorrectAnswer: 3
  - Questions: "\u042F\u043A\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u043F\u043E\u043A\u0430\u0437\u0443\u0454
      \u0442\u0435\u043A\u0441\u0442 \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456?"
    Answers:
    - int main
    - return 0
    - std::cout
    CorrectAnswer: 3
  - Questions: "\u042F\u043A \u043D\u0430\u0437\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u0433\u043E\u043B\u043E\u0432\u043D\u0430 \u0444\u0443\u043D\u043A\u0446\u0456\u044F,
      \u0437 \u044F\u043A\u043E\u0457 \u043F\u043E\u0447\u0438\u043D\u0430\u0454\u0442\u044C\u0441\u044F
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u0430?"
    Answers:
    - '#include'
    - int main()
    - hello_world()
    CorrectAnswer: 2
  - Questions: "\u0429\u043E \u0442\u0430\u043A\u0435 \u0421++?"
    Answers:
    - "\u041C\u043E\u0432\u0430 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u0443\u0432\u0430\u043D\u043D\u044F"
    - "\u041A\u043E\u043C\u043F'\u044E\u0442\u0435\u0440\u043D\u0430 \u0433\u0440\u0430"
    - "\u0406\u0433\u0440\u043E\u0432\u0438\u0439 \u0440\u0443\u0448\u0456\u0439"
    CorrectAnswer: 1
  - Questions: "\u0414\u043B\u044F \u0447\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u0436\u043D\u043E
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C
      \u0421++?"
    Answers:
    - "\u0414\u043B\u044F \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F
      \u0442\u0435\u043A\u0441\u0442\u043E\u0432\u0438\u0445 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0456\u0432"
    - "\u0414\u043B\u044F \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F
      \u043F\u0440\u0435\u0437\u0435\u043D\u0442\u0430\u0446\u0456\u0439"
    - "\u0414\u043B\u044F \u0442\u043E\u0447\u043D\u043E\u0433\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E
      \u043D\u0430\u0434 \u0430\u043F\u0430\u0440\u0430\u0442\u043D\u0438\u043C \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0435\u043D\u043D\u044F\u043C"
    CorrectAnswer: 3
  - Questions: "\u0429\u043E \u0432\u0438\u043A\u043E\u043D\u0430\u0454 \u0440\u044F\u0434\u043E\u043A
      std::cout<<\"Hello C++\";?"
    Answers:
    - "\u0412\u0438\u0432\u0435\u0434\u0435 \u043D\u0430 \u0435\u043A\u0440\u0430\u043D
