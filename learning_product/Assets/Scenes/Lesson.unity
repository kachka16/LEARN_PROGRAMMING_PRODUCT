    \u0421\u0442\u0440\u0430\u0443\u0441\u0442\u0440\u0443\u043F\u043E\u043C \u0443
    1979 \u0440\u043E\u0446\u0456, \u043D\u0438\u043D\u0456 \u0454 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u044E
