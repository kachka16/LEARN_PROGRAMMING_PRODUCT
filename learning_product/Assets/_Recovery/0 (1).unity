  m_text: "    \u041D\u0430 C++ \u0441\u0442\u0432\u043E\u0440\u044E\u044E\u0442\u044C:\n\u2022
    \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u0439\u043D\u0456 \u0441\u0438\u0441\u0442\u0435\u043C\u0438
    \u0442\u0430 \u0457\u0445 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438;\n\u2022
    \u0434\u0440\u0430\u0439\u0432\u0435\u0440\u0438 \u0434\u043B\u044F \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0457\u0432;\n\u2022
    \u0456\u0433\u0440\u043E\u0432\u0456 \u0440\u0443\u0448\u0456\u0457 \u0442\u0430
    \u0432\u0456\u0434\u0435\u043E\u0456\u0433\u0440\u0438;\n\u2022 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u0435
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043D\u0435 \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0435\u043D\u043D\u044F;\n\u2022
    \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0438 \u0442\u0430 \u0457\u0445\u043D\u0456
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438;\n\u2022 \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0435
    \u0442\u0430 \u0432\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043D\u0435
    \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0435\u043D\u043D\u044F.\n"
